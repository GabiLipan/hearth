# Copy to `.env` and fill in from your Supabase project: Settings → API.
#
# Both of these are safe to commit to a public repo and safe to ship in the
# browser bundle. The URL names the project; the publishable ("anon") key
# identifies the app. Neither grants access to any data — that is decided by
# row level security against the signed-in user's token (see supabase/02-rls.sql).
#
# The `service_role` key is different: it bypasses row level security entirely.
# It must never go in this file, in the repo, or in a build secret.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
